# Copy to .env and adjust. Placeholder values only.
# On Supabase: set this (operator-side only) to the pooler connection string of the DB owner role, then run
# `npm run db:migrate` (includes 0002_enable_rls.sql: RLS on, no policies). Never put the service-role key here;
# rotate the DB password if it was ever shared.
DATABASE_URL=postgres://mnemonis:change-me@localhost:5432/mnemonis
# POSTGRES_PASSWORD is required by docker-compose and must match the password in both URLs.
# docker/initdb creates mnemonis_test on first volume init.
# Only used by the pgStore tests (use a throwaway database):
TEST_DATABASE_URL=postgres://mnemonis:change-me@localhost:5432/mnemonis_test
POSTGRES_USER=mnemonis
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mnemonis
# Host port for the container (change if 5432 is taken):
POSTGRES_PORT=5432

# --- Auth / HTTP (names and placeholders only) ---
# Supabase project URL; the issuer (<origin>/auth/v1), JWKS URL and audience "authenticated" are derived from its origin.
SUPABASE_URL=https://your-project.supabase.co
# Only needed for non-Supabase IdPs (or to override the derived values). Must be https (http only for loopback).
# The issuer must match the token "iss" claim exactly (no trailing-slash tolerance).
# AUTH_ISSUER=
# AUTH_JWKS_URL=
# AUTH_AUDIENCE=
# Comma-separated JWT algorithms; HS* and none are refused. Default: ES256,RS256,EdDSA
# AUTH_ALGS=ES256,RS256,EdDSA
# closed (default: existing users only) | allowlist | open. allowlist and open require a verified email
# (top-level email_verified claim); with Supabase, "Confirm email" MUST be enabled.
MNEMONIS_SIGNUP_MODE=closed
# Required for allowlist: comma-separated exact emails (local@domain) or whole domains (@domain)
# MNEMONIS_ALLOWED_EMAILS=you@example.com,@example.org
# Comma-separated browser origins allowed to call the API (exact match)
# MNEMONIS_ALLOWED_ORIGINS=https://app.example.com
# Comma-separated Host header values accepted by the server
# MNEMONIS_ALLOWED_HOSTS=api.example.com
# Set true only behind a trusted reverse proxy, and only if the app is reachable solely through it.
# Only the failed-auth limiter uses X-Forwarded-For (the LAST entry, appended by your proxy); nothing else does.
# MNEMONIS_TRUST_PROXY=false
# Max active MCP tokens per user (1-1000, default 20)
# MNEMONIS_MAX_MCP_TOKENS=20
# Run pending migrations on server start (1/true). Otherwise run `npm run db:migrate` yourself.
# MNEMONIS_AUTO_MIGRATE=false
# --- Operator CLI (npm run cli): reads ONLY SUPABASE_URL, SUPABASE_ANON_KEY and MNEMONIS_API_URL from this file ---
# Public key ONLY: sb_publishable_* or an anon-role JWT (the CLI refuses anything else, e.g. service-role)
# SUPABASE_ANON_KEY=your-public-anon-key
# Server the CLI talks to (default http://127.0.0.1:8787). https, or http only for localhost; no credentials/query/fragment
# MNEMONIS_API_URL=http://127.0.0.1:8787
