# Copy to .env and adjust. The adapter has NO database, NO secrets and NO user data: everything below is plain configuration.
# Loaded by `npm run dev` / `npm start` (node --env-file-if-exists=.env).

# The Mnemonis API this adapter forwards to (a fixed setting, never taken from a request).
# https, or http on localhost; http on a private network (e.g. http://api:8787 in docker compose) also needs the opt-in below.
# No credentials, query or fragment.
# MNEMONIS_API_URL=http://127.0.0.1:8787
# MNEMONIS_API_ALLOW_INSECURE_PRIVATE=false

# Where the adapter listens (default 127.0.0.1:8788; the API is 8787, the web app 5173)
# MCP_HOST=127.0.0.1
# MCP_PORT=8788

# Extra exact Host header values accepted besides loopback with the adapter's port (DNS-rebinding defence), e.g. mcp.example.com
# MNEMONIS_ALLOWED_HOSTS=
# MCP clients send no Origin header; any Origin not listed here is refused with 403, and CORS headers are never sent.
# MNEMONIS_ALLOWED_ORIGINS=
# Set true only behind a reverse proxy that is the sole way to reach the adapter: the LAST X-Forwarded-For entry (a valid IP)
# is then the client address used for the failed-authentication limiter and forwarded to the API.
# MNEMONIS_TRUST_PROXY=false
# (With a non-loopback MCP_HOST and the line above unset, the adapter prints a loud startup warning: behind a proxy all clients share one bucket.)
# Optional shared secret with the API (the SAME value as the API's MNEMONIS_ADAPTER_SECRET; 16-256 printable ASCII, no spaces).
# Sent as X-Mnemonis-Adapter-Secret; the API then honours the client IP this adapter forwards, on /api/agent/* only, so one
# client's failed logins cannot lock out the others. Unset = the API sees only this adapter's address. Never logged.
# MNEMONIS_ADAPTER_SECRET=

# Upstream timeouts (ms) and the request body cap (bytes)
# MNEMONIS_UPSTREAM_READ_TIMEOUT_MS=10000
# MNEMONIS_UPSTREAM_WRITE_TIMEOUT_MS=20000
# MNEMONIS_MAX_BODY_BYTES=1048576
