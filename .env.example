# Copy to .env and adjust. Placeholder values only.
DATABASE_URL=postgres://mnemonis:change-me@localhost:5432/mnemonis
# POSTGRES_PASSWORD is required by docker-compose and must match the password in both URLs.
# docker/initdb creates mnemonis_test on first volume init.
# Only used by the pgStore tests (use a throwaway database):
TEST_DATABASE_URL=postgres://mnemonis:change-me@localhost:5432/mnemonis_test
POSTGRES_USER=mnemonis
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mnemonis
# Host port for the container (change if 5432 is taken):
POSTGRES_PORT=5432
